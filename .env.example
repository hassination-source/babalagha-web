# ─── Required ────────────────────────────────────────────────────────────────
# PostgreSQL 14+ connection string
DATABASE_URL="postgresql://babalagha:CHANGE_ME@localhost:5432/babalagha"

# 32+ random characters. Signs form tokens and salts IP hashes.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=""

# Public origin of the site, no trailing slash. Used for canonical URLs, sitemap and structured data.
SITE_URL="https://www.babalagha.com"

# ─── Uploads ─────────────────────────────────────────────────────────────────
# local (default): files saved to public/uploads — needs a persistent disk.
# s3: any S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO).
STORAGE_DRIVER="local"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="babalagha-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Public base URL that serves the bucket (custom domain or r2.dev URL). Also added to next/image allowlist.
# S3_PUBLIC_URL="https://media.babalagha.com"

# ─── Optional ────────────────────────────────────────────────────────────────
# Override the map tile server (default: OpenStreetMap). Respect the provider's usage policy and attribution.
# For high traffic, use a commercial provider, e.g. MapTiler: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_URL=""

# Seeding: set to "false" to skip the clearly labelled demo retailers.
# SEED_DEMO_RETAILERS="true"
